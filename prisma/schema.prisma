// StudyHub – Prisma Schema
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ── Users ─────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  timezone  String   @default("Australia/Brisbane")
  createdAt DateTime @default(now())

  semesters      Semester[]
  reviewSessions ReviewSession[]
}

// ── Academic Structure ────────────────────────────────────

model Semester {
  id        String   @id @default(cuid())
  name      String   // e.g. "Semester 1 2025"
  year      Int
  startDate DateTime
  endDate   DateTime
  userId    String
  user      User     @relation(fields: [userId], references: [id])

  units Unit[]
}

model Unit {
  id         String   @id @default(cuid())
  code       String   // e.g. "IFB104"
  name       String   // e.g. "Web Computing"
  color      String?  // Hex colour for dashboard card
  isArchived Boolean  @default(false)
  calendarId String?  // Google Calendar ID for this unit
  semesterId String
  semester   Semester @relation(fields: [semesterId], references: [id])

  weekTopics  WeekTopic[]
  quizzes     Quiz[]
  driveFolder DriveFolder?
}

model WeekTopic {
  id         String  @id @default(cuid())
  weekNumber Int     // 1–12
  title      String  // e.g. "Week 3 – REST APIs"
  objectives String? // Learning objectives (free text)
  unitId     String
  unit       Unit    @relation(fields: [unitId], references: [id])

  content  Content[]
  concepts Concept[]
}

// ── Content & Files ───────────────────────────────────────

model Content {
  id          String    @id @default(cuid())
  title       String
  // LECTURE | TUTORIAL | READING | ASSIGNMENT | OTHER
  type        String
  fileUrl     String?   // Local upload path
  driveFileId String?   // Google Drive file ID
  mimeType    String?
  aiSummary   String?   // AI-generated summary (populated after processing)
  uploadedAt  DateTime  @default(now())
  weekTopicId String
  weekTopic   WeekTopic @relation(fields: [weekTopicId], references: [id])

  tags     ContentTag[]
  concepts Concept[]
}

model Tag {
  id       String       @id @default(cuid())
  name     String       @unique // e.g. "exam", "lecture", "tutorial"
  contents ContentTag[]
}

model ContentTag {
  contentId String
  tagId     String
  content   Content @relation(fields: [contentId], references: [id])
  tag       Tag     @relation(fields: [tagId], references: [id])

  @@id([contentId, tagId])
}

// ── SRS Core ──────────────────────────────────────────────

/// An atomic study concept — the fundamental unit for SM-2 spaced repetition.
model Concept {
  id     String  @id @default(cuid())
  front  String  // Question / term shown to the student
  back   String  // Answer / definition revealed after attempt
  source String? // Origin reference (e.g. "Lecture 3, slide 12")

  // SM-2 state
  easeFactor     Float    @default(2.5) // EF – difficulty multiplier (min 1.3)
  interval       Int      @default(1)   // Days until next review
  repetitions    Int      @default(0)   // Consecutive successful reviews
  nextReviewDate DateTime @default(now())
  lastReviewedAt DateTime?

  // Optional links – a concept may come from a topic or a specific file
  weekTopicId String?
  weekTopic   WeekTopic? @relation(fields: [weekTopicId], references: [id])
  contentId   String?
  content     Content?   @relation(fields: [contentId], references: [id])

  quizQuestions QuizQuestion[]
  reviewLogs    ReviewLog[]
}

/// A study session groups multiple SM-2 review interactions together.
model ReviewSession {
  id        String    @id @default(cuid())
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  userId    String
  user      User      @relation(fields: [userId], references: [id])

  logs ReviewLog[]
}

/// Immutable record of a single SM-2 review (enables analytics / forgetting curves).
model ReviewLog {
  id               String        @id @default(cuid())
  grade            Int           // SM-2 grade: 0–5
  previousInterval Int
  newInterval      Int
  reviewedAt       DateTime      @default(now())
  conceptId        String
  concept          Concept       @relation(fields: [conceptId], references: [id])
  sessionId        String
  session          ReviewSession @relation(fields: [sessionId], references: [id])
}

// ── Quizzes ───────────────────────────────────────────────

model Quiz {
  id          String   @id @default(cuid())
  title       String
  aiGenerated Boolean  @default(false)
  createdAt   DateTime @default(now())
  unitId      String
  unit        Unit     @relation(fields: [unitId], references: [id])

  questions QuizQuestion[]
}

model QuizQuestion {
  id           String   @id @default(cuid())
  questionText String
  // MCQ | SHORT_ANSWER | TRUE_FALSE
  type         String   @default("MCQ")
  options      String?  // JSON-encoded array of option strings (MCQ only)
  answer       String
  quizId       String
  quiz         Quiz     @relation(fields: [quizId], references: [id])
  conceptId    String?  // Link to Concept if AI-generated from SRS card
  concept      Concept? @relation(fields: [conceptId], references: [id])
}

// ── Integration Metadata ──────────────────────────────────

/// Google Drive folder linked to a Unit for content sync.
model DriveFolder {
  id            String    @id @default(cuid())
  driveFolderId String    @unique
  folderName    String
  syncedAt      DateTime?
  unitId        String    @unique
  unit          Unit      @relation(fields: [unitId], references: [id])
}
